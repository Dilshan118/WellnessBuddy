<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".fragments.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Welcome Header with Modern Styling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp"
            android:gravity="center">
            
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_title"
                android:textAppearance="@style/AppNameStyle"
                android:gravity="center" />
                
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Track your wellness journey ✨"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:gravity="center" />
        </LinearLayout>

        <!-- Today's Habits Section -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/today_habits"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/habits_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_habit" />

        <!-- Mood and Hydration Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Mood Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mood_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="@color/modern_card"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mood_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😊"
                        android:textSize="32sp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mood_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mood_today"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:textAppearance="?android:attr/textAppearanceMedium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Hydration Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hydration_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="@color/modern_card"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/hydration_progress"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="16dp"
                        app:indicatorColor="@color/neon_primary"
                        app:trackColor="@color/modern_surface"
                        app:trackThickness="8dp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/hydration_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/8 glasses"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:textAppearance="?android:attr/textAppearanceMedium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Quick Actions -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_habit_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/add_habit"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_habits"
                app:backgroundTint="@color/neon_primary"
                app:cornerRadius="20dp"
                app:iconTint="@color/text_primary"
                android:elevation="8dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_mood_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/add_mood"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_mood"
                app:backgroundTint="@color/neon_secondary"
                app:cornerRadius="20dp"
                app:iconTint="@color/text_primary"
                android:elevation="8dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
