<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ultra-Modern Wellness Buddy Theme -->
    <!-- Ultra-Modern Wellness Buddy Theme -->
    <style name="WellnessBuddyTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dynamic Theme Colors -->
        <item name="android:colorBackground">@color/modern_background</item>
        <item name="colorSurface">@color/modern_surface</item>
        <item name="colorPrimary">@color/wellness_primary</item>
        <item name="colorPrimaryDark">@color/modern_background</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/modern_background</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/modern_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window Background -->
        <item name="android:windowBackground">@color/modern_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
    
    <!-- Modern Text Styles -->
    <style name="ModernTitle" parent="android:TextAppearance">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    
    <style name="ModernSubtitle" parent="android:TextAppearance">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    
    <!-- App Name Style -->
    <style name="AppNameStyle" parent="android:TextAppearance">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/wellness_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
    
    <style name="ModernBody" parent="android:TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    
    <style name="ModernCaption" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Modern Button Styles -->
    <style name="ModernButton" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/wellness_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:elevation">8dp</item>
    </style>
    
    <style name="ModernButtonSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/wellness_primary</item>
        <item name="strokeColor">@color/wellness_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:elevation">4dp</item>
    </style>
    
    <!-- Modern Card Styles -->
    <style name="ModernCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">12dp</item>
        <item name="cardBackgroundColor">@color/modern_card</item>
        <item name="android:layout_margin">12dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <style name="ModernCardHighlight" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">16dp</item>
        <item name="cardBackgroundColor">@color/modern_elevated</item>
        <item name="android:layout_margin">12dp</item>
        <item name="strokeColor">@color/wellness_primary</item>
        <item name="strokeWidth">2dp</item>
    </style>
    
    <!-- Modern Progress Styles -->
    <style name="ModernProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/wellness_primary</item>
        <item name="trackColor">@color/modern_surface</item>
        <item name="trackThickness">8dp</item>
        <item name="cornerRadius">4dp</item>
    </style>
    
    <style name="ModernCircularProgress" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/wellness_primary</item>
        <item name="trackColor">@color/modern_surface</item>
        <item name="trackThickness">6dp</item>
    </style>
    
    <!-- Modern Bottom Navigation -->
    <style name="ModernBottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/wellness_primary</item>
        <item name="itemTextColor">@color/text_secondary</item>
        <item name="android:background">@color/modern_surface</item>
        <item name="elevation">16dp</item>
        <item name="itemActiveIndicatorStyle">@style/ModernBottomNavigationIndicator</item>
    </style>
    
    <style name="ModernBottomNavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/wellness_primary</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ModernBottomNavigationIndicatorShape</item>
    </style>
    
    <style name="ModernBottomNavigationIndicatorShape" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>
    
    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="Theme.Material3.DayNight">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    
    <!-- Bottom Sheet Animation -->
    <style name="BottomSheetAnimation" parent="Animation.AppCompat.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>
</resources>
