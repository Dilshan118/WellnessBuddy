<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.wellnessbuddy.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        
        <action
            android:id="@+id/action_nav_home_to_nav_habits"
            app:destination="@id/nav_habits" />
            
        <action
            android:id="@+id/action_nav_home_to_nav_mood"
            app:destination="@id/nav_mood" />
            
        <action
            android:id="@+id/action_nav_home_to_nav_hydration"
            app:destination="@id/nav_hydration" />
            
        <action
            android:id="@+id/action_nav_home_to_nav_settings"
            app:destination="@id/nav_settings" />
    </fragment>

    <fragment
        android:id="@+id/nav_habits"
        android:name="com.example.wellnessbuddy.fragments.HabitTrackerFragment"
        android:label="Habits"
        tools:layout="@layout/fragment_habits">
        
        <action
            android:id="@+id/action_nav_habits_to_nav_home"
            app:destination="@id/nav_home" />
    </fragment>

    <fragment
        android:id="@+id/nav_mood"
        android:name="com.example.wellnessbuddy.fragments.MoodJournalFragment"
        android:label="Mood"
        tools:layout="@layout/fragment_mood">
        
        <action
            android:id="@+id/action_nav_mood_to_nav_home"
            app:destination="@id/nav_home" />
    </fragment>

    <fragment
        android:id="@+id/nav_hydration"
        android:name="com.example.wellnessbuddy.fragments.HydrationFragment"
        android:label="Hydration"
        tools:layout="@layout/fragment_hydration">
        
        <action
            android:id="@+id/action_nav_hydration_to_nav_home"
            app:destination="@id/nav_home" />
            
        <action
            android:id="@+id/action_nav_hydration_to_nav_settings"
            app:destination="@id/nav_settings" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.wellnessbuddy.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        
        <action
            android:id="@+id/action_nav_settings_to_nav_home"
            app:destination="@id/nav_home" />
            
        <action
            android:id="@+id/action_nav_settings_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.wellnessbuddy.fragments.ProfileFragment"
        android:label="My Profile"
        tools:layout="@layout/fragment_profile">
        
        <action
            android:id="@+id/action_profileFragment_to_nav_settings"
            app:destination="@id/nav_settings" />
    </fragment>

</navigation>
